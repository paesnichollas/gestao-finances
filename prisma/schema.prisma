generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================

enum RevenueCategory {
  INSCRICAO
  PATROCINIO
  VENDA
  REPASSE
  OUTRO
}

enum ExpenseCategory {
  SITE
  VIAGEM
  MARKETING
  PANFLETOS
  VIDEOS
  CONTADOR
  ABERTURA_EMPRESA
  IMPOSTO
  RESERVA_FUNDO
  OPERACIONAL
  OUTRO
}

enum RateType {
  REGISTRO_PAGADOR
  RATEIO_SOCIOS
  RATEIO_IGUALITARIO
  RATEIO_PROPORCIONAL
}

enum SettlementStatus {
  RASCUNHO
  FINALIZADO
}

// ===================== MODELS =====================

model Partner {
  id         String   @id @default(cuid())
  name       String
  percentage Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expensePayments            ExpensePayment[]
  settlementPartnerSummaries SettlementPartnerSummary[]

  @@index([isActive, name])
  @@map("partners")
}

model Revenue {
  id          String          @id @default(cuid())
  description String
  category    RevenueCategory
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime
  origin      String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@map("revenues")
}

model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory
  totalAmount Decimal         @db.Decimal(14, 2)
  date        DateTime
  notes       String?
  rateType    RateType        @default(REGISTRO_PAGADOR)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payments ExpensePayment[]

  @@index([date])
  @@map("expenses")
}

model ExpensePayment {
  id         String   @id @default(cuid())
  expenseId  String
  partnerId  String
  amountPaid Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([partnerId])
  @@map("expense_payments")
}

model Settlement {
  id             String           @id @default(cuid())
  referenceLabel String
  totalRevenue   Decimal          @db.Decimal(14, 2)
  totalExpense   Decimal          @db.Decimal(14, 2)
  netProfit      Decimal          @db.Decimal(14, 2)
  totalPaidOut   Decimal          @default(0) @db.Decimal(14, 2)
  status         SettlementStatus @default(RASCUNHO)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  partnerSummaries SettlementPartnerSummary[]

  @@index([createdAt])
  @@map("settlements")
}

model SettlementPartnerSummary {
  id                  String   @id @default(cuid())
  settlementId        String
  partnerId           String
  percentage          Decimal  @db.Decimal(5, 2)
  profitShare         Decimal  @db.Decimal(14, 2)
  reimbursableExpense Decimal  @db.Decimal(14, 2)
  finalAmount         Decimal  @db.Decimal(14, 2)
  amountAlreadyPaid   Decimal  @default(0) @db.Decimal(14, 2)
  pendingAmount       Decimal  @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  partner    Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([partnerId])
  @@map("settlement_partner_summaries")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
