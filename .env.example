# PostgreSQL (Neon, Supabase, etc.). Em serverless na Vercel, use a URL com pooler
# quando o provedor oferecer (ex.: ?pgbouncer=true ou endpoint "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth — mín. 32 caracteres; gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# URL pública do app. Local: http://localhost:3000
# Produção: https://seu-dominio.com (obrigatório se não for só *.vercel.app)
# Na Vercel, previews usam automaticamente VERCEL_URL se esta variável estiver vazia.
BETTER_AUTH_URL="http://localhost:3000"

# Opcional: cache ISR/remoto entre instâncias (sem isso, fallback em memória por função)
UPSTASH_REDIS_REST_URL="https://SEU-ENDPOINT-UPSTASH"
UPSTASH_REDIS_REST_TOKEN="SEU-TOKEN-UPSTASH"
